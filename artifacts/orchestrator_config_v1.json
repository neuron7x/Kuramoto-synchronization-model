{
  "metadata": {
    "name": "production_neuromodulator_trading_system",
    "version": "1.0.0",
    "created": "2025-11-17T01:50:00Z",
    "updated": "2025-11-17T13:10:00Z",
    "description": "Production configuration for neuromodulator-enhanced trading with TACL integration",
    "author": "Principal System Architect",
    "status": "production",
    "tags": ["neuromodulators", "dopamine", "serotonin", "tacl", "production"]
  },
  "module_sequence": [
    {
      "module_name": "data_ingestion",
      "operation": "ingest",
      "parameters": {
        "symbols": [
          "BTC/USDT",
          "ETH/USDT",
          "BNB/USDT"
        ],
        "exchange": "binance",
        "timeframe": "1h",
        "buffer_size": 2000,
        "lookback_periods": 500,
        "data_quality_checks": true,
        "fill_gaps": true,
        "validate_ohlcv": true,
        "volume_filter_enabled": true,
        "min_volume_threshold": 1000000
      },
      "priority": 0,
      "enabled": true,
      "timeout_sec": 30
    },
    {
      "module_name": "feature_extraction",
      "operation": "extract",
      "parameters": {
        "indicators": [
          "kuramoto",
          "ricci_flow",
          "entropy",
          "hurst_exponent",
          "fractal_dimension",
          "detrended_fluctuation"
        ],
        "kuramoto_config": {
          "window": 80,
          "coupling": 0.9,
          "phases": "natural_frequency"
        },
        "ricci_config": {
          "window": 200,
          "delta": 0.005,
          "neighbor_threshold": 3
        },
        "entropy_config": {
          "window": 100,
          "bins": 50,
          "method": "shannon"
        },
        "lookback": 200,
        "cache_enabled": true,
        "parallel_compute": true,
        "num_workers": 4
      },
      "priority": 1,
      "enabled": true,
      "timeout_sec": 60
    },
    {
      "module_name": "risk_assessment",
      "operation": "evaluate",
      "parameters": {
        "method": "var_es",
        "confidence": 0.95,
        "window": 50,
        "calculation_method": "historical",
        "stress_scenarios": [
          "flash_crash",
          "extended_drawdown",
          "low_liquidity"
        ],
        "position_limits": {
          "max_position_pct": 0.20,
          "max_portfolio_exposure": 0.60,
          "concentration_limit": 0.30
        },
        "drawdown_controls": {
          "max_drawdown_pct": 0.15,
          "daily_loss_limit": 5000.0,
          "weekly_loss_limit": 10000.0
        },
        "volatility_adjustment": true,
        "dynamic_sizing": true
      },
      "priority": 2,
      "enabled": true,
      "timeout_sec": 30
    },
    {
      "module_name": "action_selector",
      "operation": "select",
      "parameters": {
        "algorithm": "basal_ganglia",
        "temperature": 1.0,
        "neuromodulators": [
          "dopamine",
          "serotonin",
          "gaba",
          "noradrenaline_acetylcholine"
        ],
        "decision_model": "drift_diffusion",
        "ddm_config": {
          "threshold": 0.75,
          "noise_scale": 0.1,
          "bias": 0.0,
          "non_decision_time": 0.3
        },
        "action_space": [
          "buy",
          "sell",
          "hold",
          "close_long",
          "close_short"
        ],
        "filtering_enabled": true,
        "min_signal_strength": 0.6
      },
      "priority": 3,
      "enabled": true,
      "timeout_sec": 15
    },
    {
      "module_name": "learning_loop",
      "operation": "update",
      "parameters": {
        "algorithm": "TD(lambda)",
        "lambda": 0.8,
        "learning_rate": 0.01,
        "learning_rate_decay": 0.995,
        "min_learning_rate": 0.001,
        "discount_gamma": 0.99,
        "prediction_window": 5,
        "error_metric": "huber",
        "update_rule": "delta = reward + gamma * V_next - V_current; V_current += learning_rate * delta",
        "replay_buffer_size": 10000,
        "batch_size": 32,
        "update_frequency": 1,
        "target_network_update": 100
      },
      "priority": 4,
      "enabled": true,
      "timeout_sec": 20
    },
    {
      "module_name": "tacl_monitor",
      "operation": "validate",
      "parameters": {
        "free_energy_threshold": 1.4,
        "monotonic_descent": true,
        "protocol_hot_swap": true,
        "crisis_detection": true,
        "adaptive_recovery": true,
        "telemetry_enabled": true,
        "audit_trail_enabled": true,
        "performance_tracking": true
      },
      "priority": 5,
      "enabled": true,
      "timeout_sec": 10
    },
    {
      "module_name": "execution_manager",
      "operation": "execute",
      "parameters": {
        "venue": "binance",
        "order_type": "LIMIT",
        "time_in_force": "GTC",
        "post_only": false,
        "max_slippage_bps": 50,
        "retry_enabled": true,
        "max_retries": 3,
        "paper_trading": false,
        "dry_run": false
      },
      "priority": 6,
      "enabled": true,
      "timeout_sec": 30
    }
  ],
  "parameters": {
    "capital": 100000.0,
    "max_position_size": 0.2,
    "learning_rate": 0.01,
    "discount_gamma": 0.99,
    "exposure_limit": 0.5,
    "risk_per_trade": 0.01,
    "free_energy_threshold": 1.4,
    "temperature": 1.0,
    "dopamine": {
      "profile": "normal",
      "burst_factor": 1.5,
      "decay_rate": 0.95,
      "invigoration_threshold": 0.75,
      "no_go_threshold": 0.25,
      "hold_threshold": 0.50,
      "tonic_baseline": 0.5,
      "phasic_scale": 2.0,
      "rpe_learning_rate": 0.05,
      "temperature_modulation": true,
      "temp_k": 1.2,
      "base_temperature": 1.0,
      "ddm_enabled": true,
      "ddm_threshold_go": 0.75,
      "ddm_threshold_no_go": 0.25
    },
    "serotonin": {
      "profile": "normal",
      "stress_threshold": 0.15,
      "stress_decay": 0.95,
      "hold_temperature_floor": 0.3,
      "impulse_control_strength": 0.8,
      "patience_factor": 1.2,
      "loss_aversion_multiplier": 2.0,
      "win_streak_dampening": 0.9,
      "stress_accumulation_rate": 0.1,
      "recovery_rate": 0.05
    },
    "gaba": {
      "profile": "normal",
      "inhibition_strength": 1.0,
      "inhibition_decay": 0.9,
      "impulse_threshold": 0.5,
      "conflict_resolution_bias": 0.0,
      "override_enabled": false
    },
    "noradrenaline_acetylcholine": {
      "profile": "normal",
      "arousal_sensitivity": 1.2,
      "attention_gain": 1.0,
      "alertness_threshold": 0.6,
      "fatigue_accumulation": 0.01,
      "recovery_rate": 0.02,
      "salience_weighting": true
    },
    "tacl": {
      "enabled": true,
      "monotonic_descent": true,
      "epsilon_tolerance": 0.01,
      "crisis_detection": true,
      "crisis_thresholds": {
        "normal": 1.0,
        "elevated": 1.2,
        "critical": 1.5
      },
      "protocol_options": [
        "CRDT",
        "RDMA",
        "gRPC",
        "shared_memory",
        "gossip",
        "local_fallback"
      ],
      "adaptive_recovery": true,
      "recovery_modes": [
        "slow",
        "medium",
        "fast"
      ],
      "telemetry_retention_days": 2555,
      "audit_enabled": true
    }
  },
  "risk_contour": {
    "mode": "normal",
    "threat_threshold": 0.5,
    "exposure_limit": 0.5,
    "drawdown_limit": 0.15,
    "var_confidence": 0.95,
    "cvar_confidence": 0.975,
    "kelly_fraction_cap": 0.25,
    "position_sizing_method": "kelly",
    "dynamic_adjustment": true,
    "regime_adaptive": true
  },
  "learning_loop": {
    "algorithm": "TD(lambda)",
    "lambda": 0.8,
    "discount_gamma": 0.99,
    "learning_rate": 0.01,
    "learning_rate_schedule": "exponential_decay",
    "prediction_window": 5,
    "error_metric": "huber",
    "huber_delta": 1.0,
    "update_rule": "delta = reward + gamma * V_next - V_current; V_current += learning_rate * delta",
    "eligibility_traces": true,
    "replay_buffer_enabled": true,
    "replay_buffer_size": 10000,
    "prioritized_replay": true,
    "alpha": 0.6,
    "beta": 0.4
  },
  "monitoring": {
    "enabled": true,
    "metrics_interval_sec": 60,
    "alert_channels": [
      "prometheus",
      "slack",
      "email"
    ],
    "health_check_interval_sec": 30,
    "performance_logging": true,
    "audit_logging": true,
    "log_level": "INFO",
    "dashboard_enabled": true
  },
  "backtest": {
    "enabled": true,
    "start_date": "2023-01-01",
    "end_date": "2024-12-31",
    "warmup_periods": 200,
    "walk_forward": {
      "enabled": true,
      "train_window": 180,
      "test_window": 30,
      "step_size": 30
    },
    "monte_carlo": {
      "enabled": true,
      "iterations": 1000,
      "confidence_levels": [0.90, 0.95, 0.99]
    },
    "slippage_model": "realistic",
    "commission_model": "tiered",
    "market_impact": true
  },
  "execution": {
    "mode": "live",
    "paper_trading": false,
    "dry_run": false,
    "simulation_speed": 1.0,
    "order_execution_delay_ms": 100,
    "state_persistence": true,
    "checkpoint_interval_sec": 300,
    "recovery_enabled": true
  },
  "compliance": {
    "enabled": true,
    "jurisdiction": "global",
    "regulatory_frameworks": [
      "MiFID II",
      "SEC",
      "FINRA"
    ],
    "transaction_reporting": true,
    "audit_trail_retention_days": 2555,
    "best_execution_monitoring": true,
    "position_limits_enforcement": true
  }
}