      "description": "Overall system health status based on critical metrics and SLO compliance",
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "thresholds"
          },
          "mappings": [
            {
              "options": {
                "0": {
                  "color": "red",
                  "index": 0,
                  "text": "CRITICAL"
                },
                "1": {
                  "color": "orange",
                  "index": 1,
                  "text": "DEGRADED"
                },
                "2": {
                  "color": "green",
                  "index": 2,
                  "text": "HEALTHY"
                }
              },
              "type": "value"
            }
          ],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "orange",
                "value": 1
              },
              {
                "color": "green",
                "value": 2
              }
            ]
