      "id": 1,
      "options": {
        "orientation": "auto",
        "reduceOptions": {
          "calcs": ["lastNotNull"],
          "fields": "",
          "values": false
        },
        "showThresholdLabels": false,
        "showThresholdMarkers": true,
        "text": {}
      },
      "pluginVersion": "9.0.0",
      "targets": [
        {
          "expr": "(\n  (rate(tradepulse_orders_placed_total{status=\"error\"}[5m]) / rate(tradepulse_orders_placed_total[5m]) < 0.015) and\n  (histogram_quantile(0.95, rate(tradepulse_order_placement_duration_seconds_bucket[5m])) < 0.35) and\n  (rate(tradepulse_data_ingestion_total{status=\"error\"}[10m]) == 0)\n) * 2 + (\n  (rate(tradepulse_orders_placed_total{status=\"error\"}[5m]) / rate(tradepulse_orders_placed_total[5m]) < 0.05) or\n  (histogram_quantile(0.95, rate(tradepulse_order_placement_duration_seconds_bucket[5m])) < 0.5)\n)",
          "legendFormat": "System Health",
          "refId": "A"
