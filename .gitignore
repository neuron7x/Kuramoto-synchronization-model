# L2 killtest substrate (NARROW — prevent-regen only; selected research
# datasets and the canonical Python data API are tracked explicitly).
data/*
# Neuro-physics contradiction-ledger assurance case is a tracked audit artifact.
!data/audit/
!data/audit/**
# DAT-001 immutable dataset manifests are tracked provenance (data/manifests/*.json).
!data/manifests/
!data/manifests/**
# Real-data panels remain local until their manifests carry a granted license.
# Preserve the files locally, but fail closed against redistribution.
data/askar/
data/askar_full/
data/results/
# These manifests intentionally remain local while their license fields are
# UNKNOWN/PUBLIC_NO_LICENSE; scripts/ci/check_dataset_manifests.py is the gate.
data/manifests/askar-instruments-v1.json
data/manifests/askar-market-panel-v1.json
data/manifests/binance-btcusdt-depth10-v1.json
# The source package is code, not a generated data directory. Keep this
# exception because the unanchored `data/*` rule also matches nested paths.
!src/geosync/data/
!src/geosync/data/**
src/geosync/data/__pycache__/
src/geosync/data/**/*.pyc
# X-10R-1 allocator demo fixture (license-clean, hermetic; tracked explicitly).
