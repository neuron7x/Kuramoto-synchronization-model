{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "IncidentRecord",
  "type": "object",
  "required": [
    "incident_id",
    "created_at",
    "run_id",
    "run_hash",
    "severity",
    "trigger",
    "risk_state",
    "confidence",
    "degradations",
    "action_ids",
    "requires_human_review",
    "prohibited_autonomous_execution",
    "response_steps",
    "status"
  ],
  "properties": {
    "incident_id": {"type": "string"},
    "created_at": {"type": "string", "format": "date-time"},
    "run_id": {"type": "string"},
    "run_hash": {"type": "string"},
    "severity": {"type": "string", "enum": ["WARN", "ERROR", "CRITICAL"]},
    "trigger": {"type": "string"},
    "risk_state": {
      "type": "string",
      "enum": ["YELLOW_WATCH", "ORANGE_RISK", "RED_CRITICAL", "BLACK_INVALID"]
    },
    "confidence": {"type": "number", "minimum": 0, "maximum": 1},
    "degradations": {"type": "array", "items": {"type": "string"}},
    "action_ids": {"type": "array", "items": {"type": "string"}},
    "requires_human_review": {"type": "boolean"},
    "prohibited_autonomous_execution": {"type": "boolean"},
    "response_steps": {"type": "array", "items": {"type": "string"}},
    "status": {"type": "string", "enum": ["OPEN"]}
  },
  "additionalProperties": false
}
