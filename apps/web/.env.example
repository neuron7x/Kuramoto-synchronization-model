# =============================================================================
# TradePulse Frontend Environment Configuration
# =============================================================================
# Copy this file to .env.local for development
# NEVER commit .env.local to version control!

# =============================================================================
# Environment
# =============================================================================
NODE_ENV=development
NEXT_PUBLIC_APP_ENV=development # development, staging, production

# =============================================================================
# API Configuration
# =============================================================================
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
NEXT_PUBLIC_WS_URL=ws://localhost:8000/ws
NEXT_PUBLIC_API_TIMEOUT=30000

# =============================================================================
# Authentication
# =============================================================================
# OAuth2/OIDC Configuration
NEXT_PUBLIC_AUTH_ISSUER=https://auth.tradepulse.local
NEXT_PUBLIC_AUTH_CLIENT_ID=tradepulse-web
NEXT_PUBLIC_AUTH_REDIRECT_URI=http://localhost:3000/auth/callback
NEXT_PUBLIC_AUTH_SCOPE=openid profile email trading

# JWT Configuration (if using JWT instead of OAuth)
JWT_SECRET=your-jwt-secret-min-32-chars-long-change-in-production
JWT_EXPIRATION=24h
REFRESH_TOKEN_EXPIRATION=7d

# Session Configuration
SESSION_SECRET=your-session-secret-min-32-chars-long-change-in-production
SESSION_MAX_AGE=86400 # 24 hours in seconds

# =============================================================================
# Feature Flags
# =============================================================================
NEXT_PUBLIC_FEATURE_ADVANCED_CHARTS=true
NEXT_PUBLIC_FEATURE_PAPER_TRADING=true
NEXT_PUBLIC_FEATURE_SOCIAL_TRADING=false
NEXT_PUBLIC_FEATURE_AI_SIGNALS=false
NEXT_PUBLIC_FEATURE_STRATEGY_BUILDER=true
NEXT_PUBLIC_FEATURE_ALERTS=true
NEXT_PUBLIC_FEATURE_EXPORT_DATA=true

# =============================================================================
# Observability & Monitoring
# =============================================================================
# Sentry Configuration
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_ORG=tradepulse
SENTRY_PROJECT=tradepulse-web
SENTRY_AUTH_TOKEN=
SENTRY_ENVIRONMENT=development
NEXT_PUBLIC_SENTRY_TRACES_SAMPLE_RATE=1.0
NEXT_PUBLIC_SENTRY_REPLAYS_SESSION_SAMPLE_RATE=0.1
NEXT_PUBLIC_SENTRY_REPLAYS_ON_ERROR_SAMPLE_RATE=1.0

# Analytics
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=https://app.posthog.com
NEXT_PUBLIC_AMPLITUDE_API_KEY=
NEXT_PUBLIC_GOOGLE_ANALYTICS_ID=

# =============================================================================
# Logging
# =============================================================================
NEXT_PUBLIC_LOG_LEVEL=info # debug, info, warn, error
NEXT_PUBLIC_LOG_TO_CONSOLE=true
NEXT_PUBLIC_LOG_TO_SERVER=false

# =============================================================================
# WebSocket Configuration
# =============================================================================
NEXT_PUBLIC_WS_RECONNECT_DELAY=1000
NEXT_PUBLIC_WS_MAX_RECONNECT_DELAY=30000
NEXT_PUBLIC_WS_RECONNECT_BACKOFF=1.5
NEXT_PUBLIC_WS_MAX_RECONNECT_ATTEMPTS=10

# =============================================================================
# Real-time Data Configuration
# =============================================================================
NEXT_PUBLIC_POLLING_INTERVAL=5000 # Fallback polling interval in ms
NEXT_PUBLIC_MARKET_DATA_REFRESH=1000
NEXT_PUBLIC_POSITION_REFRESH=3000
NEXT_PUBLIC_ORDER_REFRESH=2000

# =============================================================================
# Trading Configuration
# =============================================================================
NEXT_PUBLIC_DEFAULT_LEVERAGE=1
NEXT_PUBLIC_MAX_LEVERAGE=10
NEXT_PUBLIC_MIN_ORDER_SIZE=0.001
NEXT_PUBLIC_PRICE_PRECISION=2
NEXT_PUBLIC_QUANTITY_PRECISION=6

# =============================================================================
# UI/UX Configuration
# =============================================================================
NEXT_PUBLIC_DEFAULT_LOCALE=en
NEXT_PUBLIC_SUPPORTED_LOCALES=en,uk,de,fr,es,ja,zh
NEXT_PUBLIC_DEFAULT_TIMEZONE=UTC
NEXT_PUBLIC_DEFAULT_THEME=light # light, dark, system
NEXT_PUBLIC_CURRENCY_FORMAT=USD
NEXT_PUBLIC_DATE_FORMAT=YYYY-MM-DD HH:mm:ss

# Table Configuration
NEXT_PUBLIC_DEFAULT_PAGE_SIZE=20
NEXT_PUBLIC_MAX_PAGE_SIZE=100
NEXT_PUBLIC_ENABLE_VIRTUALIZATION=true

# Chart Configuration
NEXT_PUBLIC_CHART_THEME=light
NEXT_PUBLIC_DEFAULT_TIMEFRAME=1h
NEXT_PUBLIC_CHART_UPDATE_INTERVAL=1000

# =============================================================================
# Performance
# =============================================================================
NEXT_PUBLIC_ENABLE_SERVICE_WORKER=false
NEXT_PUBLIC_CACHE_STRATEGY=cache-first # cache-first, network-first, stale-while-revalidate
NEXT_PUBLIC_PRELOAD_MARKET_DATA=true

# =============================================================================
# Security
# =============================================================================
# CSRF Protection
CSRF_SECRET=your-csrf-secret-min-32-chars-long-change-in-production

# Rate Limiting
NEXT_PUBLIC_API_RATE_LIMIT=100
NEXT_PUBLIC_API_RATE_LIMIT_WINDOW=60000 # in ms

# Content Security Policy
NEXT_PUBLIC_CSP_REPORT_URI=

# =============================================================================
# Development Tools
# =============================================================================
NEXT_PUBLIC_ENABLE_DEVTOOLS=true
NEXT_PUBLIC_ENABLE_MOCK_API=false
NEXT_PUBLIC_MOCK_DELAY=500

# =============================================================================
# Testing
# =============================================================================
TEST_API_BASE_URL=http://localhost:8000
TEST_WS_URL=ws://localhost:8000/ws
TEST_TIMEOUT=30000

# =============================================================================
# Build Configuration
# =============================================================================
ANALYZE_BUNDLE=false
SOURCE_MAPS=true

# =============================================================================
# External Services (Optional)
# =============================================================================
# Email notifications
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=noreply@tradepulse.local

# Webhook notifications
NEXT_PUBLIC_WEBHOOK_URL=

# =============================================================================
# Notes
# =============================================================================
# How to generate secure secrets:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
#
# How to use this file:
#   1. Copy to .env.local: cp .env.example .env.local
#   2. Fill in your values
#   3. Never commit .env.local to git
#   4. Use NEXT_PUBLIC_ prefix for client-side variables
#   5. Variables without NEXT_PUBLIC_ are server-side only
