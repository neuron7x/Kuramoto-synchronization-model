  "decision_rule": {
    "controlled_input": "changed repository path",
    "expected_output": "deterministic pytest selector plan",
    "fail_closed_on_invalid_matrix": true,
    "fail_closed_on_unmapped_required_surface": true
  },
  "description": "Maps changed repository paths to the deterministic pytest selectors that must pass for that component. core/* is a required surface: a core change with no route is blocked (unmapped_required_surface), never silently skipped. Subpackages of core/ without a test directory (accelerators, architecture, engine, io, maintenance, phase, reporting, top-level modules) are deliberately unmapped and therefore blocked until a route exists. Patterns use fnmatch semantics ('*' crosses '/').",
  "required_mapping_patterns": [
    "core/*"
  ],
  "router_policy": {
    "default_max_run_selectors": 8,
    "priority_component_ids": [
      "controlled_component_test_router"
    ],
    "python_executable_env": "COMPONENT_ROUTER_PYTHON"
  },
  "schema": "geosync.component_test_matrix.v1",
  "status": "normative",
  "title": "Controlled component-test routing matrix"
}
