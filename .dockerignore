.env.*
.DS_Store

# Node and frontend build artifacts
node_modules/
ui/node_modules/
apps/web/node_modules/

# Documentation, tests, and local-only assets
backlog/
bench/
docs/
newsfragments/
reports/
tests/
artifacts/

# Editor and IDE settings
.idea/
.vscode/
.ruff_cache/
