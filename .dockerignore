# Exclude version control metadata and development artefacts from the Docker build context.
.git
.gitignore
.github

# Tests, documentation, and local tooling are not required for the runtime image.
docs
newsfragments
reports
bench
backlog
loadtests
backtest
sbom
site
sitecustomize.py

# Python cache directories and compiled files.
__pycache__/
*.py[cod]
*$py.class

# Local tooling and configuration that should not be baked into images.
*.log
*.pytest_cache/
.tox/
.mypy_cache/
.pytest_cache/
.cache/

# Ignore temporary build artefacts.
artifacts/
*.egg-info/

