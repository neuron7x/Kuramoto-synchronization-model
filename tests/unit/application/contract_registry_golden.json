{
  "api": {
    "geosync.api.v1.features": {
      "authorization": {
        "audience": "geosync.api",
        "description": "Signed JWT issued by the platform identity provider.",
        "name": "service-jwt",
        "scopes": [
          "features:read",
          "predictions:read"
        ],
        "token_type": "Bearer"
      },
      "description": "Generate engineered feature snapshots for a symbol.",
      "idempotency": {
        "enforce_replay_fingerprint": true,
        "key": "Idempotency-Key",
        "safe_methods": [
          "POST"
        ],
        "ttl_seconds": 3600
      },
      "method": "POST",
      "name": "geosync.api.v1.features",
      "observability": {
        "default_attributes": {
          "api.version": "v1"
        },
        "metrics_namespace": "api.features",
        "span_name": "api.features"
      },
      "path": "/api/v1/features",
      "rate_limit_per_minute": 120,
      "retry_policy": {
        "backoff_multiplier": 2.0,
        "initial_interval_seconds": 0.25,
        "jitter_seconds": 0.05,
        "max_attempts": 1,
        "max_interval_seconds": 5.0
      },
      "sla": {
        "description": "Online inference latency and availability objectives.",
        "indicators": [
          {
            "description": "95th percentile latency must remain under 350ms.",
            "metric": "p95_latency_ms",
            "name": "p95_latency",
            "target": 350.0,
            "threshold_type": "lte"
          },
          {
            "description": "Successful responses must exceed 99.5% per rolling hour.",
            "metric": "success_rate",
            "name": "success_rate",
            "target": 0.995,
            "threshold_type": "gte"
          }
        ],
        "name": "api.v1.latency"
      },
      "versioning": {
        "changelog_url": null,
        "compatible_since": "1.0.0",
        "current": "1.2.0",
        "deprecated": false,
        "lifecycle": "active",
        "scheme": "semver"
      }
    },
