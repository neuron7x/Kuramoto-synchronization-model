[flake8]
max-line-length = 120
extend-ignore =
    E203,
    W503,
    E704
per-file-ignores =
    */__init__.py:F401
    core/neuro/tests/test_ecs_regulator.py:E402
exclude =
    .git,
    __pycache__,
    build,
    dist,
    .venv,
    venv,
    .mypy_cache,
    .ruff_cache,
    .pytest_cache,
    docs,
    sbom,
    data,
    reports,
    nfpro/generated
select =
    C,E,F,W,B,B950
