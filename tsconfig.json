{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,
    "noImplicitOverride": true,
    "moduleResolution": "Bundler",
    "resolveJsonModule": true,
    "isolatedDeclarations": true,
    "skipLibCheck": false
  }
}
