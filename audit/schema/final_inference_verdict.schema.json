{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "geosync.final_inference_verdict.v1",
  "title": "GeoSync Final Inference-Integrity Verdict",
  "description": "Aggregates every inference-integrity sub-verdict (coverage, mutable state, concurrency, causal prefix, runtime failure, risk reservation, cache freshness, event-bus lifecycle, and under --release component strength + RVG) into one final verdict. PASS only when every consumed artifact is present, schema-valid, passing, and not report-only.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "release", "inputs", "verdict"],
  "properties": {
    "schema": { "const": "geosync.final_inference_verdict.v1" },
    "release": { "type": "boolean" },
    "report_only": { "type": "boolean" },
    "verdict": { "enum": ["PASS", "FAIL"] },
    "inputs": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "path", "tier", "present", "verdict", "report_only", "passed", "reason"],
        "properties": {
          "name": { "type": "string", "minLength": 1 },
          "path": { "type": "string", "minLength": 1 },
          "tier": { "enum": ["substrate", "release"] },
          "present": { "type": "boolean" },
          "verdict": { "type": ["string", "null"] },
          "report_only": { "type": "boolean" },
          "passed": { "type": "boolean" },
          "reason": { "type": "string" }
        }
      }
    }
  }
}
