{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "geosync.runtime_failure_matrix.v1",
  "title": "GeoSync Runtime Failure Matrix",
  "description": "Cross-checks fail-closed behaviour across DB/IO/execution/messaging components: each row binds a plausible runtime failure class to the test that proves the component fails closed (typed failure / explicit degraded verdict / exception), never a fake success.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "rows", "verdict"],
  "properties": {
    "schema": { "const": "geosync.runtime_failure_matrix.v1" },
    "rows": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "component",
          "failure_class",
          "test",
          "expected_behavior",
          "observed_behavior",
          "verdict"
        ],
        "properties": {
          "component": { "type": "string", "minLength": 1 },
          "failure_class": {
            "type": "string",
            "enum": [
              "missing dependency",
              "timeout",
              "connection refused",
              "malformed payload",
              "empty input",
              "NaN/Infinity",
              "duplicate id",
              "out-of-order timestamp",
              "future leakage",
              "unknown enum/status",
              "threshold boundary",
              "secret leakage",
              "stale artifact",
              "wrong hash",
              "non-atomic commit",
              "resource wedge"
            ]
          },
          "test": {
            "type": "string",
            "pattern": "^tests/.+\\.py::[A-Za-z0-9_:]+$"
          },
          "expected_behavior": { "type": "string", "enum": ["fail_closed"] },
          "observed_behavior": { "type": "string", "enum": ["fail_closed"] },
          "verdict": { "type": "string", "enum": ["PASS", "FAIL"] }
        }
      }
    },
    "verdict": { "type": "string", "enum": ["PASS", "FAIL"] }
  }
}
