{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "geosync.risk_reservation_lifecycle.v1",
  "title": "GeoSync Risk Reservation Lifecycle",
  "description": "Declares the pending-exposure reservation state machine enforced by RiskManager: validation reserves, fills convert, terminal paths release. Each transition and invariant binds to a real defect-sensitive test so the claim 'no order passes on actual exposure while pending exposure exists' cannot silently rot.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "component",
    "config_flag",
    "default_enabled",
    "leak_detector",
    "states",
    "transitions",
    "invariants",
    "terminal_release_paths",
    "tests",
    "verdict"
  ],
  "properties": {
    "schema": { "const": "geosync.risk_reservation_lifecycle.v1" },
    "component": { "type": "string", "minLength": 1 },
    "config_flag": { "type": "string", "minLength": 1 },
    "default_enabled": { "type": "boolean" },
    "leak_detector": { "type": "string", "minLength": 1 },
    "states": {
      "type": "array",
      "minItems": 2,
      "items": { "type": "string", "minLength": 1 }
    },
    "transitions": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["from", "to", "trigger", "effect"],
        "properties": {
          "from": { "type": "string", "minLength": 1 },
          "to": { "type": "string", "minLength": 1 },
          "trigger": { "type": "string", "minLength": 1 },
          "effect": { "type": "string", "minLength": 1 }
        }
      }
    },
    "invariants": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "statement", "test"],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "statement": { "type": "string", "minLength": 1 },
          "test": { "type": "string", "minLength": 1 }
        }
      }
    },
    "terminal_release_paths": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "minLength": 1 }
    },
    "tests": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "minLength": 1 }
    },
    "verdict": { "enum": ["BOUND", "UNBOUND"] }
  }
}
