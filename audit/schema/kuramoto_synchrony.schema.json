{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "geosync.kuramoto_synchrony.v1",
  "title": "GeoSync Kuramoto Synchronisation Certificate",
  "description": "Second-domain transfer of the verification apparatus: certifies the real KuramotoEngine exhibits the synchronisation phase transition (strong coupling locks, weak coupling incoherent, a clear transition gap, order parameter bounded in [0,1], seeded determinism).",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "component", "checks", "gate", "verdict"],
  "properties": {
    "schema": { "const": "geosync.kuramoto_synchrony.v1" },
    "component": { "type": "string", "minLength": 1 },
    "r_lock": { "type": "number" },
    "r_steady_high": { "type": "number" },
    "r_steady_mid": { "type": "number" },
    "r_steady_low": { "type": "number" },
    "gate": { "enum": ["SYNCHRONISING", "INCOHERENT"] },
    "report_only": { "type": "boolean" },
    "verdict": { "enum": ["PASS", "FAIL"] },
    "checks": {
      "type": "array", "minItems": 5,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["id", "name", "holds"],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "name": { "type": "string", "minLength": 1 },
          "holds": { "type": "boolean" }
        }
      }
    }
  }
}
