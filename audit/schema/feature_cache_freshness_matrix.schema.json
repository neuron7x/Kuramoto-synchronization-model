{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "geosync.feature_cache_freshness_matrix.v1",
  "title": "GeoSync Feature-Cache Freshness Matrix",
  "description": "Feature data served to live inference must never go backward in event time. Each invariant binds a freshness rule of the realtime feature cache (event-time CAS, tz normalisation, us round-trip, malformed/missing rejection, authoritative ordered DB fallback) to the test that proves it.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "component", "invariants", "verdict"],
  "properties": {
    "schema": { "const": "geosync.feature_cache_freshness_matrix.v1" },
    "component": { "type": "string", "minLength": 1 },
    "verdict": { "enum": ["PASS", "FAIL"] },
    "invariants": {
      "type": "array",
      "minItems": 8,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "statement", "test", "verdict"],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "statement": { "type": "string", "minLength": 1 },
          "test": { "type": "string", "minLength": 1 },
          "verdict": { "enum": ["PASS", "FAIL"] }
        }
      }
    }
  }
}
