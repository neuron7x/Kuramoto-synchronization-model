{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "RVG normalized mutation result",
  "type": "object",
  "required": ["tool", "killed", "survived", "valid_mutants", "mutation_score"],
  "properties": {
    "tool": { "type": "string" },
    "killed": { "type": "integer", "minimum": 0 },
    "survived": { "type": "integer", "minimum": 0 },
    "timeout": { "type": "integer", "minimum": 0 },
    "incompetent": { "type": "integer", "minimum": 0 },
    "timeout_counted_as_killed": { "type": "boolean" },
    "valid_mutants": { "type": "integer", "minimum": 0 },
    "mutation_score": { "type": "number", "minimum": 0, "maximum": 100 }
  }
}
