{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.neuron7xlab.org/research/ricci_microstructure_artifact.v1.schema.json",
  "title": "GeoSync Ricci Microstructure Artifact v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "run_id",
    "schema_version",
    "config_hash",
    "data_sha256",
    "git_sha",
    "mean_curvature",
    "p_value",
    "cliffs_delta",
    "effect_size_class",
    "null_model_type",
    "n_surrogates",
    "falsification_status",
    "replay_command",
    "timestamp_utc",
    "claim_tier",
    "kernel_version",
    "source",
    "source_class",
    "license_status",
    "config_sha256",
    "collector_sha256",
    "dirty_git",
    "seed",
    "observed_count",
    "null_mean",
    "null_std",
    "forbidden_claims_absent"
  ],
  "properties": {
    "run_id": {"type": "string", "minLength": 1},
    "schema_version": {"const": "ricci_microstructure_artifact.v1"},
    "kernel_version": {"type": "string", "minLength": 1},
    "source": {"enum": ["LOBSTER_LICENSED_L2", "BINANCE_FUTURES_DEPTH"]},
    "source_class": {"enum": ["LOBSTER_LICENSED", "BINANCE_PUBLIC_DEPTH", "SYNTHETIC_CONTROL", "EXTERNAL_OPERATOR_SUPPLIED"]},
    "license_status": {"enum": ["PUBLIC_NO_LICENSE", "LICENSED", "SYNTHETIC", "OPERATOR_ATTESTED"]},
    "config_hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "config_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "data_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "collector_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "git_sha": {"type": "string", "pattern": "^[0-9a-f]{40}$", "not": {"const": "0000000000000000000000000000000000000000"}},
    "dirty_git": {"const": false},
    "seed": {"type": "integer"},
    "mean_curvature": {"type": "number"},
    "observed_count": {"type": "integer", "minimum": 1},
    "null_mean": {"type": "number"},
    "null_std": {"type": "number", "minimum": 0},
    "p_value": {"type": "number", "minimum": 0, "maximum": 1},
    "cliffs_delta": {"type": "number", "minimum": -1, "maximum": 1},
    "effect_size_class": {"enum": ["negligible", "small", "medium", "large"]},
    "null_model_type": {"enum": ["iaaft", "shuffled_timestamps", "random_walk", "volume_neutral", "size_permutation_within_side", "block_bootstrap"]},
    "n_surrogates": {"type": "integer", "minimum": 1000},
    "falsification_status": {"enum": ["SUPPORTED", "HYPOTHESIS_NOT_SUPPORTED", "INVALID"]},
    "forbidden_claims_absent": {"const": true},
    "replay_command": {"type": "string", "pattern": "^geosync-research run --line ricci_microstructure_v1"},
    "timestamp_utc": {"type": "string", "format": "date-time"},
    "claim_tier": {"const": "T3/NOVEL/EXPLORATORY/FALSIFIABLE"}
  },
  "allOf": [
    {
      "comment": "NC-06 substrate-class binding: a Binance public-depth session must be tagged BINANCE_PUBLIC_DEPTH / PUBLIC_NO_LICENSE and can NEVER be relabelled as a licensed LOBSTER substrate.",
      "if": {"properties": {"source": {"const": "BINANCE_FUTURES_DEPTH"}}},
      "then": {"properties": {"source_class": {"const": "BINANCE_PUBLIC_DEPTH"}, "license_status": {"const": "PUBLIC_NO_LICENSE"}}}
    },
    {
      "comment": "NC-06: a LOBSTER-grade result requires the licensed substrate class + LICENSED status.",
      "if": {"properties": {"source": {"const": "LOBSTER_LICENSED_L2"}}},
      "then": {"properties": {"source_class": {"const": "LOBSTER_LICENSED"}, "license_status": {"const": "LICENSED"}}}
    }
  ]
}
