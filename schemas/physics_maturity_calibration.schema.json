{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "NFI Physics Maturity Calibration",
  "type": "object",
  "required": [
    "version",
    "status",
    "score_credit_allowed",
    "adaptations",
    "intentions",
    "evolutions",
    "non_claims"
  ],
  "properties": {
    "version": {"type": "string"},
    "status": {"type": "string"},
    "score_credit_allowed": {"const": false},
    "adaptations": {
      "type": "array",
      "minItems": 7,
      "maxItems": 7,
      "items": {
        "type": "object",
        "required": ["id", "name", "metric", "gate", "limit"],
        "properties": {
          "id": {"type": "string", "pattern": "^ADAPT-[1-7]$"},
          "name": {"type": "string"},
          "metric": {"type": "string"},
          "gate": {"type": "string"},
          "limit": {"type": "string"}
        },
        "additionalProperties": false
      }
    },
    "intentions": {
      "type": "array",
      "minItems": 7,
      "maxItems": 7,
      "items": {
        "type": "object",
        "required": ["id", "name", "metric", "owner", "resource"],
        "properties": {
          "id": {"type": "string", "pattern": "^INTENT-[1-7]$"},
          "name": {"type": "string"},
          "metric": {"type": "string"},
          "owner": {"type": "string"},
          "resource": {"type": "string"}
        },
        "additionalProperties": false
      }
    },
    "evolutions": {
      "type": "array",
      "minItems": 7,
      "maxItems": 7,
      "items": {
        "type": "object",
        "required": ["id", "name", "from", "to", "signal"],
        "properties": {
          "id": {"type": "string", "pattern": "^EVO-[1-7]$"},
          "name": {"type": "string"},
          "from": {"type": "string"},
          "to": {"type": "string"},
          "signal": {"type": "string"}
        },
        "additionalProperties": false
      }
    },
    "non_claims": {
      "type": "array",
      "minItems": 1,
      "items": {"type": "string"}
    }
  },
  "additionalProperties": false
}
