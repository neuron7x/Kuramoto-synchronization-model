{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "schemas/governance/fractal_neuro_cognitive_execution.schema.json",
  "title": "Fractal Neuro Cognitive Execution Input",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "input_vec",
    "signal_val",
    "layer_decomposition",
    "validation_status",
    "system_action",
    "claim_boundary"
  ],
  "properties": {
    "input_vec": {
      "type": "string",
      "minLength": 1,
      "description": "Compressed intent vector."
    },
    "signal_val": {
      "type": "number",
      "minimum": 0,
      "maximum": 1,
      "description": "Confidence score bound to evidence, not sentiment."
    },
    "layer_decomposition": {
      "type": "object",
      "additionalProperties": false,
      "required": ["physical", "informational", "computational", "cognitive"],
      "properties": {
        "physical": {
          "type": "object",
          "additionalProperties": false,
          "required": ["constraint_key"],
          "properties": {
            "constraint_key": {"type": "string", "minLength": 1}
          }
        },
        "informational": {
          "type": "object",
          "additionalProperties": false,
          "required": ["entropy_delta"],
          "properties": {
            "entropy_delta": {"type": "number"}
          }
        },
        "computational": {
          "type": "object",
          "additionalProperties": false,
          "required": ["complexity_class"],
          "properties": {
            "complexity_class": {"type": "string", "minLength": 1}
          }
        },
        "cognitive": {
          "type": "object",
          "additionalProperties": false,
          "required": ["functional_intent"],
          "properties": {
            "functional_intent": {"type": "string", "minLength": 1}
          }
        }
      }
    },
    "validation_status": {
      "type": "string",
      "enum": ["VERIFIED", "PLAUSIBLE", "SPECULATIVE"]
    },
    "system_action": {
      "type": "string",
      "minLength": 1
    },
    "claim_boundary": {
      "type": "object",
      "additionalProperties": false,
      "required": ["allowed_claims", "blocked_claims"],
      "properties": {
        "allowed_claims": {
          "type": "array",
          "items": {"type": "string", "minLength": 1}
        },
        "blocked_claims": {
          "type": "array",
          "minItems": 1,
          "items": {"type": "string", "minLength": 1}
        }
      }
    }
  }
}
