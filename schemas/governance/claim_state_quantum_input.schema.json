{
  "title": "Claim-State Quantum Input",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "claim_id",
    "claim_text",
    "source_refs",
    "test_refs",
    "commands",
    "artifacts",
    "ci_proof",
    "failure_mode",
    "rollback",
    "claim_boundary",
    "negative_evidence"
  ],
  "properties": {
    "claim_id": {"type": "string", "minLength": 1},
    "claim_text": {"type": "string", "minLength": 1},
    "declared_state": {
      "type": "string",
      "enum": ["FALSE", "UNTESTED", "PARTIAL", "LOCAL_VERIFIED", "CI_VERIFIED", "EVIDENCE_BEARING"]
    },
    "contradicted": {"type": "boolean"},
    "source_refs": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
    "test_refs": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
    "commands": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["cmd", "output_ref"],
        "properties": {
          "cmd": {"type": "string", "minLength": 1},
          "output_ref": {"type": "string", "minLength": 1},
          "exit_code": {"type": "integer"}
        }
      }
    },
    "artifacts": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
    "ci_proof": {
      "type": "object",
      "additionalProperties": false,
      "required": ["same_sha", "required_checks_green"],
      "properties": {
        "sha": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
        "same_sha": {"type": "boolean"},
        "required_checks_green": {"type": "boolean"},
        "run_url": {"type": "string", "minLength": 1}
      }
    },
    "scientific_evidence": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "real_data": {"type": "boolean"},
        "replay": {"type": "boolean"},
        "baseline": {"type": "boolean"},
        "falsifier": {"type": "boolean"},
        "semantic_validation": {"type": "boolean"},
        "artifact_ref": {"type": "string", "minLength": 1}
      }
    },
    "failure_mode": {"type": "string", "minLength": 1},
    "rollback": {"type": "string", "minLength": 1},
    "claim_boundary": {
      "type": "object",
      "additionalProperties": false,
      "required": ["allowed", "blocked"],
      "properties": {
        "allowed": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
        "blocked": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}}
      }
    },
    "negative_evidence": {"type": "array", "items": {"type": "string", "minLength": 1}}
  }
}
