{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://neuron7xlab.github.io/GeoSync/schemas/audit/contradiction_ledger.schema.json",
  "title": "Neuro-Physics Contradiction Ledger (Assurance-Case v2)",
  "description": "Machine-readable, continuously-verifiable assurance case for neuro/physics claims in GeoSync. Each contradiction is a defended claim structured as a Toulmin argument (grounds -> warrant -> backing -> qualifier -> rebuttal) with W3C-PROV provenance and an executable falsifier. The falsifier exits 0 IFF the ledger's stated position is still true against live source, so a later code change that invalidates an entry FORCES a ledger update through CI. No closure without evidence; no claim without an executable check.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version",
    "methodology",
    "claim_status_vocab",
    "severity_vocab",
    "resolution_vocab",
    "contradictions"
  ],
  "properties": {
    "version": { "type": "integer", "minimum": 2 },
    "description": { "type": "string" },
    "methodology": {
      "type": "object",
      "additionalProperties": false,
      "description": "Declares the argumentation standard the ledger conforms to.",
      "required": ["argument_model", "provenance_model", "verification"],
      "properties": {
        "argument_model": { "type": "string", "minLength": 4 },
        "provenance_model": { "type": "string", "minLength": 4 },
        "verification": { "type": "string", "minLength": 4 },
        "references": { "type": "array", "items": { "type": "string" } }
      }
    },
    "claim_status_vocab": {
      "type": "array",
      "items": { "enum": ["VERIFIED", "PLAUSIBLE", "UNSUPPORTED", "CONTRADICTED"] },
      "minItems": 4,
      "uniqueItems": true
    },
    "severity_vocab": {
      "type": "array",
      "items": { "enum": ["HIGH", "MEDIUM", "LOW"] },
      "minItems": 3,
      "uniqueItems": true
    },
    "resolution_vocab": {
      "type": "array",
      "items": { "enum": ["OPEN", "IN_PROGRESS", "RESOLVED", "WONTFIX"] },
      "minItems": 4,
      "uniqueItems": true
    },
    "contradictions": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/contradiction" }
    }
  },
  "$defs": {
    "argument": {
      "type": "object",
      "additionalProperties": false,
      "description": "Toulmin argument structure defending the claim.",
      "required": ["warrant", "backing", "rebuttal"],
      "properties": {
        "warrant": { "type": "string", "minLength": 16 },
        "backing": { "type": "string", "minLength": 8 },
        "rebuttal": { "type": "string", "minLength": 16 }
      }
    },
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "description": "W3C-PROV-style attribution of the assertion.",
      "required": ["asserted_by", "asserted_on", "method"],
      "properties": {
        "asserted_by": { "type": "string", "minLength": 3 },
        "asserted_on": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$" },
        "method": { "type": "string", "minLength": 8 }
      }
    },
    "falsifier": {
      "type": "object",
      "additionalProperties": false,
      "description": "Executable probe. The command is authored to exit `expect_exit` IFF the entry's current position is true against live source.",
      "required": ["command", "expect_exit", "interpretation"],
      "properties": {
        "command": { "type": "string", "minLength": 4 },
        "expect_exit": { "type": "integer", "enum": [0] },
        "interpretation": { "type": "string", "minLength": 8 }
      }
    },
    "contradiction": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "title",
        "source_path",
        "contradiction",
        "severity",
        "claim_status",
        "owner_lane",
        "evidence",
        "argument",
        "provenance",
        "falsifier",
        "resolution_state"
      ],
      "properties": {
        "id": { "type": "string", "pattern": "^C-[A-Z0-9]+-[0-9]{3}$" },
        "title": { "type": "string", "minLength": 8 },
        "source_path": { "type": "string", "minLength": 3 },
        "source_lines": { "type": "string" },
        "contradiction": { "type": "string", "minLength": 16 },
        "severity": { "enum": ["HIGH", "MEDIUM", "LOW"] },
        "claim_status": { "enum": ["VERIFIED", "PLAUSIBLE", "UNSUPPORTED", "CONTRADICTED"] },
        "owner_lane": { "type": "string" },
        "evidence": { "type": "string", "minLength": 8 },
        "argument": { "$ref": "#/$defs/argument" },
        "provenance": { "$ref": "#/$defs/provenance" },
        "falsifier": { "$ref": "#/$defs/falsifier" },
        "resolution_state": { "enum": ["OPEN", "IN_PROGRESS", "RESOLVED", "WONTFIX"] },
        "resolution_ref": { "type": "string" }
      },
      "allOf": [
        {
          "$comment": "HIGH/MEDIUM contradictions must name a non-empty owner lane.",
          "if": { "properties": { "severity": { "enum": ["HIGH", "MEDIUM"] } } },
          "then": { "properties": { "owner_lane": { "minLength": 3 } } }
        },
        {
          "$comment": "No fake closure: RESOLVED requires a resolution_ref.",
          "if": { "properties": { "resolution_state": { "const": "RESOLVED" } } },
          "then": { "required": ["resolution_ref"], "properties": { "resolution_ref": { "minLength": 2 } } }
        }
      ]
    }
  }
}
