{
  "title": "Autonomy Trend Ledger",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "entries", "summary"],
  "properties": {
    "schema_version": {"const": "autonomy_trend.v1"},
    "entries": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["sequence", "cycle_schema_version", "cycle_sha256", "decision_state", "status_vector", "status_counts", "phase_count"],
        "properties": {
          "sequence": {"type": "integer", "minimum": 1},
          "cycle_schema_version": {"type": "string", "minLength": 1},
          "cycle_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
          "decision_state": {"enum": ["READY_FOR_NEXT_CYCLE", "OBSERVE_WITH_DEBT", "EVIDENCE_GAP", "REPAIR_REQUIRED", "UNKNOWN"]},
          "status_vector": {"type": "array", "items": {"type": "string"}},
          "status_counts": {"type": "object", "additionalProperties": {"type": "integer", "minimum": 1}},
          "phase_count": {"type": "integer", "minimum": 0}
        }
      }
    },
    "summary": {
      "type": "object",
      "additionalProperties": false,
      "required": ["total_cycles", "decision_counts", "status_counts", "phase_count_total", "latest_decision_state", "latest_cycle_sha256"],
      "properties": {
        "total_cycles": {"type": "integer", "minimum": 0},
        "decision_counts": {"type": "object", "additionalProperties": {"type": "integer", "minimum": 1}},
        "status_counts": {"type": "object", "additionalProperties": {"type": "integer", "minimum": 1}},
        "phase_count_total": {"type": "integer", "minimum": 0},
        "latest_decision_state": {"type": ["string", "null"]},
        "latest_cycle_sha256": {"type": ["string", "null"], "pattern": "^[0-9a-f]{64}$"}
      }
    }
  }
}
