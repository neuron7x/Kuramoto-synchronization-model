{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://geosync.local/schemas/mfn_multi_agent_cycle.schema.json",
  "title": "MFN Multi-Agent Evidence Cycle",
  "type": "object",
  "additionalProperties": false,
  "required": ["cycle_id", "objective", "agent_outputs", "artifact_delta", "evidence_status", "reverse_trace", "next_deterministic_action", "final_gate"],
  "properties": {
    "cycle_id": {"type": "string", "minLength": 1},
    "objective": {
      "type": "object",
      "additionalProperties": false,
      "required": ["target_state", "current_state", "transformation", "action_vector"],
      "properties": {
        "target_state": {"type": "string"},
        "current_state": {"type": "string"},
        "transformation": {"type": "string"},
        "action_vector": {"const": "earn -> exit -> build systems"}
      }
    },
    "agent_outputs": {
      "type": "object",
      "additionalProperties": false,
      "required": ["orchestrator", "web_evidence_agent", "local_code_builder", "integrator", "verifier", "falsifier", "validator_calibrator"],
      "properties": {
        "orchestrator": {"$ref": "#/$defs/role_output"},
        "web_evidence_agent": {"$ref": "#/$defs/role_output"},
        "local_code_builder": {"$ref": "#/$defs/role_output"},
        "integrator": {"$ref": "#/$defs/role_output"},
        "verifier": {"$ref": "#/$defs/role_output"},
        "falsifier": {"$ref": "#/$defs/role_output"},
        "validator_calibrator": {"$ref": "#/$defs/role_output"}
      }
    },
    "artifact_delta": {"type": "array", "minItems": 1, "items": {"type": "string"}},
    "evidence_status": {
      "type": "object",
      "additionalProperties": false,
      "required": ["external_evidence_available", "evidence_source", "tests_executed", "tests_not_executed", "score", "confidence", "status"],
      "properties": {
        "external_evidence_available": {"const": true},
        "evidence_source": {"enum": ["python_runner", "pytest", "ci_log", "parser_log", "benchmark_output", "human_review"]},
        "tests_executed": {"type": "array", "items": {"type": "string"}},
        "tests_not_executed": {"type": "array", "items": {"type": "string"}},
        "score": {"type": "null"},
        "confidence": {"type": "number", "maximum": 0.9},
        "status": {"const": "BLOCKED"}
      }
    },
    "reverse_trace": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/reverse_trace"}},
    "next_deterministic_action": {"type": "string", "minLength": 1},
    "final_gate": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "reason", "evidence_required"],
      "properties": {
        "status": {"const": "BLOCKED"},
        "reason": {"type": "string", "minLength": 1},
        "evidence_required": {"type": "array", "minItems": 1, "items": {"type": "string"}}
      }
    }
  },
  "$defs": {
    "role_output": {
      "type": "object",
      "required": ["role", "status"],
      "properties": {
        "role": {"type": "string", "minLength": 1},
        "status": {"type": "string", "minLength": 1}
      }
    },
    "reverse_trace": {
      "type": "object",
      "additionalProperties": false,
      "required": ["failure", "cause", "component", "patch", "test", "evidence"],
      "properties": {
        "failure": {"type": "string", "minLength": 1},
        "cause": {"type": "string", "minLength": 1},
        "component": {"type": "string", "minLength": 1},
        "patch": {"type": "string", "minLength": 1},
        "test": {"type": "string", "minLength": 1},
        "evidence": {"type": "string", "minLength": 1}
      }
    }
  }
}
