{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://neuron7xlab.local/schemas/pr_preflight_report.schema.json",
  "title": "GeoSync PR preflight report",
  "description": "Declarative contract for the JSON report emitted by tools/ci/pr_preflight.py. Mirrors the engine's code-level validate_report_contract; tests/ci/test_pr_preflight_report_schema.py asserts the status enums here stay in lockstep with the engine constants so the schema cannot drift from the code.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "status",
    "root",
    "started_at",
    "finished_at",
    "duration_seconds",
    "checks",
    "summary",
    "failure_count",
    "next_action",
    "first_file_to_open"
  ],
  "properties": {
    "schema_version": {"const": 1},
    "status": {"enum": ["PASS", "FAIL", "BLOCKED"]},
    "root": {"type": "string", "minLength": 1},
    "started_at": {"type": "string", "minLength": 1},
    "finished_at": {"type": "string", "minLength": 1},
    "duration_seconds": {"type": "number", "minimum": 0},
    "failure_count": {"type": "integer", "minimum": 0},
    "next_action": {"type": "string"},
    "first_file_to_open": {"type": "string", "pattern": "preflight_report\\.json$"},
    "summary": {"type": "object"},
    "checks": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "name",
          "critical",
          "status",
          "command",
          "exit_code",
          "duration_seconds",
          "stdout_log",
          "stderr_log",
          "failure_reason",
          "tool_available",
          "cwd",
          "timeout_seconds",
          "success_exit_codes",
          "optional_if_missing"
        ],
        "properties": {
          "id": {"type": "string", "pattern": "^[a-z0-9_]+$"},
          "name": {"type": "string", "minLength": 1},
          "critical": {"type": "boolean"},
          "status": {"enum": ["PASS", "FAIL", "SKIPPED_OPTIONAL", "BLOCKED", "TIMEOUT"]},
          "command": {"type": "array", "items": {"type": "string"}},
          "exit_code": {"type": ["integer", "null"]},
          "duration_seconds": {"type": "number", "minimum": 0},
          "stdout_log": {"type": "string"},
          "stderr_log": {"type": "string"},
          "failure_reason": {"type": "string"},
          "tool_available": {"type": "boolean"},
          "cwd": {"type": "string", "minLength": 1},
          "timeout_seconds": {"type": "number", "exclusiveMinimum": 0},
          "success_exit_codes": {"type": "array", "items": {"type": "integer"}},
          "optional_if_missing": {"type": "boolean"}
        }
      }
    }
  }
}
